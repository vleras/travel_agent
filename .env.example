# Server-side only — never prefix this key with VITE_
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Optional — without this key the agent uses curated city attractions (still fully functional)
VITE_GEMINI_API_KEY=

# Pexels — place photos (https://www.pexels.com/api/)
VITE_PEXELS_API_KEY=your_pexels_api_key_here
