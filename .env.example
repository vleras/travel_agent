# Server-side only — never prefix this key with VITE_
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Optional attraction-generation fallback; does not replace DeepSeek chat
VITE_GEMINI_API_KEY=

# Pexels — place photos (https://www.pexels.com/api/)
VITE_PEXELS_API_KEY=

# Geoapify — food places and geocoding (https://www.geoapify.com/)
VITE_GEOAPIFY_KEY=

# Optional TomTom hotel search (https://developer.tomtom.com/)
VITE_TOMTOM_KEY=

# Weather (Open-Meteo) and email (FormSubmit) need no environment keys.
# VITE_ values are browser-visible. Never store server secrets under VITE_.
